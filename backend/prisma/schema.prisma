generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  domain          String?          @unique
  subdomain       String           @unique
  isActive        Boolean          @default(true)
  paymentProvider String           @default("adyen")
  theme           Json
  paymentConfig   Json
  deliveryConfig  Json
  emailConfig     Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  currency        String           @default("EUR")
  deliveries      Delivery[]
  deliveryZones   DeliveryZone[]
  deliveryFeeTiers DeliveryFeeTier[]
  orders          Order[]
  productMappings ProductMapping[]
  products        Product[]

  @@map("tenants")
}

model Product {
  id              String      @id @default(cuid())
  tenantId        String?     // null = shared, value = tenant-specific
  slug            String       // URL-friendly identifier
  name            String
  description     String?
  priceCents      Int
  taxRate         Float       @default(20.0)
  category        String
  image           String?
  modifiers       Json?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isBestSeller    Boolean     @default(false)
  weightGrams     Int?        // Gramáž v gramoch (napr. 450, 500, 520)
  allergens       String[]    // Pole alergénov (napr. ["1", "7"])
  displayName     String?     // Voliteľný webový názov (prepíše mapovanie, používa sa pre všetky jazyky)
  subHeader       String?     // Sub-header v JSON formáte {sk: "...", en: "..."}
  tenantOverrides Json?       @default("{}")  // Per-tenant customization for shared products
  orderItems      OrderItem[]
  tenant          Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slug, tenantId])  // Slug unique within tenant (null tenantId = shared)
  @@index([tenantId])         // Fast filtering by tenant
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("products")
}

model Order {
  id               String      @id @default(cuid())
  tenantId         String
  orderNumber      Int?
  status           OrderStatus @default(PENDING)
  customer         Json
  address          Json
  subtotalCents    Int
  taxCents         Int
  deliveryFeeCents Int
  totalCents       Int
  paymentRef       String?
  paymentStatus    String?
  deliveryId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  storyousOrderId  String?
  userId           String?
  items            OrderItem[]
  delivery         Delivery?   @relation(fields: [deliveryId], references: [id])
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  user             User?       @relation(fields: [userId], references: [id])

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, orderNumber])
  @@index([paymentRef])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  priceCents  Int
  modifiers   Json?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Delivery {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String   @default("wolt")
  jobId       String?
  status      String
  trackingUrl String?
  quote       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  orders      Order[]

  @@index([jobId])
  @@map("deliveries")
}

model User {
  id                   String                @id @default(cuid())
  password             String?
  name                 String
  role                 UserRole              @default(OPERATOR)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  username             String?               @unique
  phone                String?               @unique
  phoneVerified        Boolean               @default(false)
  appleId              String?               @unique
  email                String?               @unique
  googleId             String?               @unique
  passwordResetExpires DateTime?
  passwordResetToken   String?               @unique
  addresses            Address[]
  orders               Order[]
  refreshTokens        RefreshToken[]
  smsVerificationCodes SmsVerificationCode[]

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([passwordResetToken])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model SmsVerificationCode {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([code])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  street      String
  description String?
  city        String
  postalCode  String
  country     String   @default("SK")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("addresses")
}

model ProductMapping {
  id                  String   @id @default(cuid())
  tenantId            String
  externalIdentifier  String
  internalProductName String
  source              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalIdentifier, source])
  @@index([tenantId, externalIdentifier])
  @@index([internalProductName])
  @@map("product_mappings")
}

model DeliveryZone {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  deliveryFeeCents Int
  minOrderCents    Int?
  postalCodes      String[]
  cityNames        String[]
  cityParts        String[]
  isActive         Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("delivery_zones")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum UserRole {
  ADMIN
  OPERATOR
  CUSTOMER
}

model DeliveryFeeTier {
  id                String    @id @default(cuid())
  tenantId          String?
  minDistanceMeters Int
  maxDistanceMeters Int
  deliveryFeeCents  Int
  isActive          Boolean   @default(true)
  priority          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, priority])
  @@index([isActive, priority])
  @@map("delivery_fee_tiers")
}

// Global settings for platform-wide configuration (e.g., Storyous credentials)
model GlobalSettings {
  id        String   @id @default("global")
  storyous  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_settings")
}

// Audit log for tracking all tenant modifications
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  action      String   // "CLONE", "SYNC", "UPDATE", "CREATE"
  entityType  String   // "TENANT", "PRODUCT", "DELIVERYZONE"
  entityId    String?
  userId      String?  // Admin user who performed action
  changes     Json?    // Before/after snapshot
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now())
  
  @@map("audit_logs")
  @@index([tenantId, action])
  @@index([createdAt])
}

// Tenant backups for rollback capability
model TenantBackup {
  id          String   @id @default(cuid())
  tenantId    String
  snapshot    Json     // Full tenant data
  createdAt   DateTime @default(now())
  expiresAt   DateTime // Auto-delete after 30 days
  
  @@map("tenant_backups")
  @@index([tenantId])
  @@index([expiresAt])
}
