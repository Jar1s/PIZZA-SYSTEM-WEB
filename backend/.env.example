# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pizza_ecosystem?schema=public"

# Auth / JWT
JWT_SECRET="replace-with-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-at-least-32-character-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
OAUTH_COOKIE_DOMAIN=""

# Frontend / URLs / CORS
FRONTEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3000"
API_URL="http://localhost:3000"
DEFAULT_DOMAIN="localhost:3001"
ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# Tenant / app behavior
DEFAULT_TAX_RATE="20.0"
TENANT_CACHE_TTL_MS="30000"

# Google OAuth
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/customer/google/callback"

# Apple OAuth
APPLE_CLIENT_ID="com.example.web"
APPLE_SERVICE_ID="com.example.service"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI="http://localhost:3000/api/auth/customer/apple/callback"

# Email (global SMTP fallback)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD="replace-me"
SMTP_FROM_EMAIL="noreply@example.com"
EMAIL_FROM="Pizza Ecosystem <noreply@example.com>"
EMAIL_ASSET_BASE_URL="http://localhost:3001"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Payments / webhooks
ADYEN_ENVIRONMENT="TEST"
ADYEN_HMAC_KEY=""
GOPAY_CLIENT_SECRET=""
WEPAY_HMAC_KEY=""
SKIP_WEBHOOK_VERIFICATION="false"

# Delivery integrations
KITCHEN_PHONE="+421900000000"
WOLT_SUPPORT_EMAIL="support@example.com"
WOLT_WEBHOOK_SECRET=""

# Storyous integration
STORYOUS_ENABLED="false"
STORYOUS_CLIENT_ID=""
STORYOUS_CLIENT_SECRET=""

# Observability
SENTRY_DSN=""
